# Copy to backend/.env and adjust.

# --- Database ---------------------------------------------------------------
# Default (no value) = SQLite file backend/workforce.db
# MySQL 8 example (create the database first: CREATE DATABASE workforce_ai CHARACTER SET utf8mb4;)
# DATABASE_URL=mysql+pymysql://workforce:your_password@localhost:3306/workforce_ai

# --- Security ---------------------------------------------------------------
# Use a long random value in any shared/production environment.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# When true, /api/auth/forgot-password returns the reset token (no SMTP in dev).
DEV_MODE=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
